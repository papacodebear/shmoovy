# Discord application credentials
DISCORD_TOKEN=
PUBLIC_KEY=
APP_ID=

# Spotify app credentials (Client Credentials flow - catalog search/link resolution only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Express server (defaults to 3000 if unset)
PORT=3000

# Optional overrides if yt-dlp/ffmpeg aren't on PATH
YTDLP_PATH=
FFMPEG_PATH=
